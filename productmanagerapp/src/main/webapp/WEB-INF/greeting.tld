<?xml version="1.0" encoding="UTF-8" ?>
<taglib  xmlns ="jakarta.ee" version="3.0">

    <tlib-version>1.0</tlib-version>
    <short-name>greeting</short-name>
    <!-- This is the URI you'll reference in the JSP via taglib directive -->
    <uri>http://example.com/tags/greeting</uri>

    <tag>
        <name>greet</name>
        <tag-class>com.mphasis.productmanagerapp.customtags.GreetingTag</tag-class>
        <body-content>empty</body-content>

        <attribute>
            <name>name</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.String</type>
        </attribute>

        <attribute>
            <name>timeOfDay</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.String</type>
        </attribute>
    </tag>
</taglib>